{
  "name": "cmu-library-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "CMU Library Explorer website: TypeScript + Supabase, built with esbuild and served as static files.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "test:sql": "node tests/sql.test.mjs",
    "test:lockout": "node tests/lockout.test.mjs",
    "test:assistant": "node tests/assistant-api.test.mjs",
    "test:css": "node tests/css-audit.test.mjs",
    "test:links": "node tests/links.test.mjs",
    "test:notice": "node tests/notice-api.test.mjs",
    "test:loan-mail": "node tests/loan-mail.test.mjs && node tests/loan-mail-many.test.mjs",
    "test:tools": "node tests/assistant-tools.test.mjs",
    "test:borrowing": "node tests/borrowing-rules.test.mjs",
    "test": "npm run typecheck && npm run test:sql && npm run test:lockout && npm run test:assistant && npm run test:notice && npm run test:loan-mail && npm run test:tools && npm run test:borrowing && npm run test:css && npm run build && npm run test:links"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "jsqr": "^1.4.0",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
